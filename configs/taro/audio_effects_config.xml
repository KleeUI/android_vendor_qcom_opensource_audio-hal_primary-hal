<audio_effects_conf version="2.0"
        xmlns="http://schemas.android.com/audio/audio_effects_conf/v2_0">
    <!--
      The QTI factory on taro implements Effect V2. Keep this graph limited to
      libraries built against Effect V2; Effect V4 software libraries cannot
      be registered in this factory because their AIDL ABI is incompatible.
    -->
    <libraries>
        <library name="offload_bundle" path="libqcompostprocbundle.so"/>
        <library name="visualizer_hw" path="libqcomvisualizer.so"/>
        <library name="audio_pre_processing" path="libqcomvoiceprocessing.so"/>
        <library name="volume_listener" path="libvolumelistener.so"/>
    </libraries>

    <effects>
        <effect name="bassboost" library="offload_bundle"
                uuid="2c4a8c24-1581-487f-94f6-0002a5d5c51b"/>
        <effect name="virtualizer" library="offload_bundle"
                uuid="509a4498-561a-4bea-b3b1-0002a5d5c51b"/>
        <effect name="equalizer" library="offload_bundle"
                uuid="a0dac280-401c-11e3-9379-0002a5d5c51b"/>
        <effect name="reverb_env_aux" library="offload_bundle"
                uuid="79a18026-18fd-4185-8233-0002a5d5c51b"/>
        <effect name="reverb_env_ins" library="offload_bundle"
                uuid="eb64ea04-973b-43d2-8f5e-0002a5d5c51b"/>
        <effect name="reverb_pre_aux" library="offload_bundle"
                uuid="6987be09-b142-4b41-9056-0002a5d5c51b"/>
        <effect name="reverb_pre_ins" library="offload_bundle"
                uuid="aa2bebf6-47cf-4613-9bca-0002a5d5c51b"/>
        <effect name="visualizer" library="visualizer_hw"
                uuid="7a8044a0-1a71-11e3-a184-0002a5d5c51b"/>
        <effect name="aec" library="audio_pre_processing"
                uuid="0f8d0d2a-59e5-45fe-b6e4-248c8a799109"
                type="7b491460-8d4d-11e0-bd61-0002a5d5c51b"/>
        <effect name="ns" library="audio_pre_processing"
                uuid="1d97bb0b-9e2f-4403-9ae3-58c2554306f8"
                type="58b4b260-8e06-11e0-aa8e-0002a5d5c51b"/>
        <effect name="music_helper" library="volume_listener"
                uuid="08b8b058-0590-11e5-ac71-0025b32654a0"
                typeSameAsUuid="true"/>
        <effect name="ring_helper" library="volume_listener"
                uuid="0956df94-0590-11e5-bdbe-0025b32654a0"
                typeSameAsUuid="true"/>
        <effect name="alarm_helper" library="volume_listener"
                uuid="09f303e2-0590-11e5-8fdb-0025b32654a0"
                typeSameAsUuid="true"/>
        <effect name="voice_helper" library="volume_listener"
                uuid="0ace5c08-0590-11e5-ae9e-0025b32654a0"
                typeSameAsUuid="true"/>
        <effect name="notification_helper" library="volume_listener"
                uuid="0b776dde-0590-11e5-81ba-0025b32654a0"
                typeSameAsUuid="true"/>
    </effects>

    <postprocess>
        <stream type="music">
            <apply effect="music_helper"/>
        </stream>
        <stream type="ring">
            <apply effect="ring_helper"/>
        </stream>
        <stream type="alarm">
            <apply effect="alarm_helper"/>
        </stream>
        <stream type="voice_call">
            <apply effect="voice_helper"/>
        </stream>
        <stream type="notification">
            <apply effect="notification_helper"/>
        </stream>
    </postprocess>

    <preprocess>
        <stream type="voice_communication">
            <apply effect="aec"/>
            <apply effect="ns"/>
        </stream>
    </preprocess>
</audio_effects_conf>
